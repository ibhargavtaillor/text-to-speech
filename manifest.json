{
  "manifest_version": 3,
  "name": "Podcastify — Listen to Any Page",
  "version": "1.0.0",
  "description": "Turn articles, blogs, news and docs into a podcast-style listening experience.",
  "minimum_chrome_version": "116",

  "permissions": [
    "tts",
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Podcastify",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
